# Paper mode works without credentials.
TRADING_MODE=paper

# Stop new entries after this long without any complete, fresh market snapshot.
DATA_STALE_HALT_MS=90000
# Recover a stale-data latch only after this many consecutive fresh cycles and
# at least this many usable markets. Kill, daily-loss, and manual-pause latches
# are not cleared by stale-data recovery.
DATA_STALE_RECOVERY_CYCLES=3
DATA_STALE_RECOVERY_MIN_MARKETS=4

# Exact HTTPS Site origins allowed to read the daemon's loopback /status endpoint.
# Keep this limited to Sites you control; requests remain read only.
PQE_DASHBOARD_ORIGINS=https://polymarket-quant-engine.coopdogg67.chatgpt.site

# Explicit local-development opt-in. Keep disabled on shared or proxied hosts.
POLYMARKET_LIVE_ALLOW_LOCALHOST=false
POLYMARKET_LIVE_ALLOWED_USER_ID=
POLYMARKET_LIVE_SESSION_SECRET=
# Required on any deployment reachable from the network: disables the local-owner bypass.
POLYMARKET_HOSTED=false
POLYMARKET_TELEGRAM_SESSION_SECRET=

# Wallet settings for the live terminal trader. Use signature type 1 for a Polymarket Proxy.
# The signer private key is never read from the environment; the trader asks for it at a hidden prompt.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1
# Optional: require LOCK-tier signals for live entries (default: ENTRY or LOCK).
POLYMARKET_LIVE_REQUIRE_LOCK=false
# Optional: fitted model weights written by pnpm run calibrate (default: var/model-calibration.json).
POLYMARKET_CALIBRATION_FILE=
