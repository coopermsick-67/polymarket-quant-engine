# Paper mode works without credentials.
TRADING_MODE=paper

# Explicit local-development opt-in. Keep disabled on shared or proxied hosts.
POLYMARKET_LIVE_ALLOW_LOCALHOST=false
POLYMARKET_LIVE_ALLOWED_USER_ID=
POLYMARKET_LIVE_SESSION_SECRET=
POLYMARKET_LIVE_EXECUTION_ENABLED=false
POLYMARKET_TELEGRAM_SESSION_SECRET=
