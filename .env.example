# Paper mode works without credentials.
TRADING_MODE=paper

# Server-side only. Never expose these through the browser or localStorage.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
# Explicit localhost-only opt-in for trusted-machine live testing.
POLYMARKET_LIVE_ALLOW_LOCALHOST=false
POLYMARKET_LIVE_ALLOWED_USER_ID=
POLYMARKET_LIVE_SESSION_SECRET=
POLYMARKET_TELEGRAM_SESSION_SECRET=

# Optional server/database configuration for the future adapter.
DATABASE_URL=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
