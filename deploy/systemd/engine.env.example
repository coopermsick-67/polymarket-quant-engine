# The headless worker refuses every mode except paper.
TRADING_MODE=paper
STATE_DIR=/var/lib/polymarket-quant-engine
POLL_INTERVAL_MS=15000
DECISION_INTERVAL_MS=1000
DATA_STALE_HALT_MS=90000
DATA_STALE_RECOVERY_MIN_MARKETS=1
PQE_DASHBOARD_ORIGINS=https://polymarket-quant-engine.coopdogg67.chatgpt.site

# Paper simulation limits only; no account credentials are used by this daemon.
# Typed MICRO/SMALL/GROWTH/STANDARD/LARGE profiles enforce the tighter cap.
# PAPER_MIN_BET_USD is an operator floor, never permission to exceed a cap.
# The CLOB minimum share size must be known and safely affordable or entry PASSes.
PAPER_STARTING_CASH=100
PAPER_MIN_BET_USD=1
PAPER_MAX_BET_PCT=0.05
PAPER_MAX_EXPOSURE_PCT=0.15
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_DAILY_LOSS_PCT=0.05
PAPER_MIN_NET_EDGE=0.04
PAPER_FEE_RATE=0.02
PAPER_SLIPPAGE_BPS=15
