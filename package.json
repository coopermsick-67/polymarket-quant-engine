{
  "name": "polymarket-quant-engine",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"scripts/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"scripts/*.ts\" \"tests/**/*.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "headless": "node --import tsx scripts/headless.ts",
    "replay": "node --import tsx scripts/replay.ts",
    "backfill": "node --import tsx scripts/backfill.ts",
    "report": "node --import tsx scripts/nightly-report.ts"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "1.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.56.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
